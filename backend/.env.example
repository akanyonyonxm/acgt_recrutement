# Copier en .env et adapter. Le .env n'est PAS versionné.

# --- Sécurité ---
SECRET_KEY=changez-moi-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données ---
# Dev : laisser vide -> SQLite. Production : décommenter pour PostgreSQL.
# DB_ENGINE=postgresql
# DB_NAME=acgt_recrutement
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Compte administrateur (optionnel) ---
# Si défini, un superuser est créé au démarrage. Laisser vide en dev pour
# utiliser `manage.py createsuperuser` à la place.
# ADMIN_EMAIL=admin@acgt.cd
# ADMIN_PASSWORD=
# ADMIN_RESET_PASSWORD=False

# --- Front Vue (CORS + CSRF) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Origines de confiance pour le CSRF (mettre l'URL réelle du front en prod).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email Resend ---
# Laisser vide -> backend console (dev). Renseigner la clé -> envoi réel.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=notifications@recrutement.acgt.cd
EMAIL_FROM_NOM=ACGT Recrutement
SITE_NOM=Plateforme de recrutement ACGT

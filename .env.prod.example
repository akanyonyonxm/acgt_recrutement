# Modèle d'environnement de PRODUCTION (VPS recrutement.acgt.cd / 167.71.45.222).
# Copier en .env À LA RACINE du projet : c'est le fichier lu par les deux
# fichiers docker-compose (base + application). Ne jamais committer le .env réel.
#
#   cp .env.prod.example .env   &&   nano .env

# --- Sécurité Django ---
# Générer une clé robuste, ex. :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=remplacez-par-une-cle-secrete-longue-et-aleatoire
DEBUG=False
# Domaine public + IP du VPS (Django rejette tout hôte non listé).
ALLOWED_HOSTS=recrutement.acgt.cd,167.71.45.222

# --- Base de données PostgreSQL ---
# DB_ENGINE/DB_HOST/DB_PORT sont forcés par docker-compose.prod.yml (postgresql/db/5432).
DB_NAME=acgt_recrutement
DB_USER=acgt
DB_PASSWORD=remplacez-par-un-mot-de-passe-fort

# --- Compte administrateur ---
# Créé automatiquement au démarrage du backend (superuser, email vérifié).
# Laisser vide pour ne pas le créer. Le mot de passe n'est PAS réécrasé si le
# compte existe déjà (mettre ADMIN_RESET_PASSWORD=True pour forcer).
ADMIN_EMAIL=admin@acgt.cd
ADMIN_PASSWORD=remplacez-par-un-mot-de-passe-admin-fort
# ADMIN_RESET_PASSWORD=False

# --- Front / CORS / CSRF (HTTPS, même origine) ---
FRONTEND_URL=https://recrutement.acgt.cd
CORS_ALLOWED_ORIGINS=https://recrutement.acgt.cd
CSRF_TRUSTED_ORIGINS=https://recrutement.acgt.cd

# --- Emails Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=notifications@recrutement.acgt.cd
EMAIL_FROM_NOM=ACGT Recrutement
EMAIL_REPLY_TO=recrutement@acgt.cd
SITE_NOM=Plateforme de recrutement ACGT

# --- Certbot / Let's Encrypt (utilisé par scripts/init-letsencrypt.sh) ---
LETSENCRYPT_EMAIL=recrutement@acgt.cd

# --- Gunicorn (optionnel) ---
# GUNICORN_WORKERS=3
